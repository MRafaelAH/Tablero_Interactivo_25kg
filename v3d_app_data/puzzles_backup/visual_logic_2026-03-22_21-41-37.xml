          <field name="HIGHLIGHT_MODE">javascript</field>
          <field name="TEXT" editor-height="31" editor-width="784.4645244382423">// 1. Obtener coordenadas precisas (corrección de desfase)&amp;#10;const container = app.container;&amp;#10;const rect = container.getBoundingClientRect();&amp;#10;const mouse = new v3d.Vector2();&amp;#10;&amp;#10;mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;&amp;#10;mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;&amp;#10;&amp;#10;// 2. Lanzar el rayo de detección&amp;#10;const raycaster = new v3d.Raycaster();&amp;#10;raycaster.setFromCamera(mouse, app.getCamera());&amp;#10;const intersects = raycaster.intersectObjects(app.scene.children, true);&amp;#10;&amp;#10;if (intersects.length &gt; 0) {&amp;#10;    let objetoTocado = intersects[0].object;&amp;#10;    &amp;#10;    // --- LÓGICA DE RASTREO DE NOMBRE ---&amp;#10;    // A veces Verge3D nombra la malla como "Mesh_001", &amp;#10;    // pero nosotros queremos el nombre del Padre (el Objeto de Blender).&amp;#10;    let nombreFinal = objetoTocado.name;&amp;#10;    &amp;#10;    // Si el nombre parece ser una malla genérica, buscamos al padre&amp;#10;    if (objetoTocado.parent &amp;&amp; (nombreFinal.includes('Mesh') || nombreFinal.includes('pCube'))) {&amp;#10;        nombreFinal = objetoTocado.parent.name;&amp;#10;    }&amp;#10;&amp;#10;    // 3. Salida de datos limpia en consola&amp;#10;    console.log("%c --- DETECCIÓN DE COMPONENTE ---", "color: #00ff00; font-weight: bold;");&amp;#10;    console.log("Nombre detectado: %c" + nombreFinal, "color: #00fbff; font-size: 14px; font-weight: bold;");&amp;#10;    console.log("ID Único (UUID): " + objetoTocado.uuid);&amp;#10;    console.log("Tipo de objeto: " + objetoTocado.type);&amp;#10;    console.log("---------------------------------");&amp;#10;&amp;#10;} else {&amp;#10;    console.log("%c Clic en el vacío: No se detectó nada.", "color: #ff9900;");&amp;#10;}</field>
        </shadow>
      </value>
