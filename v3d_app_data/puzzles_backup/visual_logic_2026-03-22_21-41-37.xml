              <field name="HIGHLIGHT_MODE">javascript</field>
              <field name="TEXT" editor-height="31" editor-width="784.4645244382423">// 1. Configuración de detección&amp;#10;const rect = app.container.getBoundingClientRect();&amp;#10;const mouse = new v3d.Vector2();&amp;#10;&amp;#10;mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;&amp;#10;mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;&amp;#10;&amp;#10;// 2. Raycaster&amp;#10;const raycaster = new v3d.Raycaster();&amp;#10;raycaster.setFromCamera(mouse, app.getCamera());&amp;#10;const intersects = raycaster.intersectObjects(app.scene.children, true);&amp;#10;&amp;#10;// Inicializamos la señal en 0 (No hay coincidencia)&amp;#10;VARS['existe_variable'] = 0;&amp;#10;&amp;#10;if (intersects.length &gt; 0) {&amp;#10;    let obj = intersects[0].object;&amp;#10;    let nombreDetectado = "";&amp;#10;&amp;#10;    // Buscamos el nombre real&amp;#10;    if (obj.parent &amp;&amp; (obj.name.includes('Mesh') || obj.name.includes('Object'))) {&amp;#10;        nombreDetectado = obj.parent.name;&amp;#10;    } else {&amp;#10;        nombreDetectado = obj.name;&amp;#10;    }&amp;#10;&amp;#10;    // --- VALIDACIÓN DE SEÑAL ---&amp;#10;    // Si el nombre detectado existe como variable en Puzzles...&amp;#10;    if (VARS[nombreDetectado] !== undefined) {&amp;#10;        &amp;#10;        VARS['objeto_detectado'] = nombreDetectado; // Pasamos el nombre&amp;#10;        VARS['existe_variable'] = 1;               // ¡Activamos la señal!&amp;#10;        &amp;#10;        console.log("Señal ACTIVADA para: " + nombreDetectado);&amp;#10;    } else {&amp;#10;        // No hacemos nada con 'objeto_detectado', la señal se queda en 0&amp;#10;        console.log("Señal RECHAZADA: No hay variable para " + nombreDetectado);&amp;#10;    }&amp;#10;}</field>
