                                      <next>
                                        <block type="execScript" id="vRUv8]08^z(/Y$iG?yz0">
                                          <value name="TEXT">
                                            <shadow type="textMultiline" id="N^}smFnv`hjybc4Gk;t:">
                                              <field name="HIGHLIGHT_MODE">javascript</field>
                                              <field name="TEXT" editor-height="37" editor-width="787.9075">// 1. COMPROBACIÓN DE SEGURIDAD (Por si no se ha inicializado el post-processing)&amp;#10;if (!app.postprocessing) {&amp;#10;    app.enablePostprocessing();&amp;#10;}&amp;#10;&amp;#10;// 2. CONFIGURACIÓN DEL RAYCASTER (EL "PUNTERO" INVISIBLE)&amp;#10;const raycaster = new v3d.Raycaster();&amp;#10;const mouse = new v3d.Vector2();&amp;#10;const rect = app.container.getBoundingClientRect();&amp;#10;&amp;#10;// Convertimos la posición del mouse al espacio 3D de la cámara&amp;#10;mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;&amp;#10;mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;&amp;#10;&amp;#10;raycaster.setFromCamera(mouse, app.getCamera());&amp;#10;&amp;#10;// Buscamos qué objetos atravesó el "rayo" del clic&amp;#10;const intersects = raycaster.intersectObjects(app.scene.children, true);&amp;#10;&amp;#10;// 3. LÓGICA DE DETECCIÓN Y RESALTADO&amp;#10;if (intersects.length &gt; 0) {&amp;#10;    let obj = intersects[0].object;&amp;#10;&amp;#10;    // Subir al padre si el objeto es parte de un grupo (común en modelos CAD/Inventor)&amp;#10;    if (obj.parent &amp;&amp; (obj.name.includes('Mesh') || obj.name.includes('Object'))) {&amp;#10;        obj = obj.parent;&amp;#10;    }&amp;#10;&amp;#10;    // Accedemos al OutlinePass (la silueta)&amp;#10;    const outline = app.postprocessing.outlinePass;&amp;#10;&amp;#10;    if (outline) {&amp;#10;        // --- AQUÍ ESTÁ EL TRUCO DEL TOGGLE ---&amp;#10;        &amp;#10;        // ¿El objeto que tocamos ya está en la lista de resaltados?&amp;#10;        const estaSeleccionado = outline.selectedObjects.includes(obj);&amp;#10;&amp;#10;        if (estaSeleccionado) {&amp;#10;            // SI YA ESTABA: Lo quitamos (Limpiamos la selección)&amp;#10;            outline.selectedObjects = [];&amp;#10;            VARS['objeto_detectado'] = ""; // Limpiamos variable de Puzzle&amp;#10;            console.log("Desmarcado:", obj.name);&amp;#10;        } else {&amp;#10;            // SI NO ESTABA: Lo marcamos (Ponemos la silueta)&amp;#10;            outline.selectedObjects = [obj];&amp;#10;            VARS['objeto_detectado'] = obj.name; // Guardamos para Puzzles&amp;#10;            console.log("Marcado:", obj.name);&amp;#10;        }&amp;#10;    }&amp;#10;&amp;#10;    // Actualizamos si existe lógica personalizada para este componente&amp;#10;    VARS['existe_variable'] = (VARS[obj.name] !== undefined) ? 1 : 0;&amp;#10;&amp;#10;} else {&amp;#10;    // OPCIONAL: Si haces clic al fondo (al aire), quitar el resaltado actual&amp;#10;    if (app.postprocessing?.outlinePass) {&amp;#10;        app.postprocessing.outlinePass.selectedObjects = [];&amp;#10;        VARS['objeto_detectado'] = "";&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;// --- FUNCIÓN DE SOPORTE PARA LA CÁMARA ---&amp;#10;// (Verge3D necesita saber si moviste la cámara para que la silueta no se desfase)&amp;#10;if (!app.renderCallbacks.includes(actualizarCamaraOutline)) {&amp;#10;    app.renderCallbacks.push(actualizarCamaraOutline);&amp;#10;}&amp;#10;&amp;#10;function actualizarCamaraOutline() {&amp;#10;    if (app.postprocessing?.outlinePass) {&amp;#10;        app.postprocessing.outlinePass.renderCamera = app.getCamera();&amp;#10;    }&amp;#10;}</field>
                                            </shadow>
                                          </value>
                                          <next>
                                            <block type="execScript" id="6NzQaqFP{#)~=3|*zfIF">
                                              <value name="TEXT">
                                                <shadow type="textMultiline" id="U*ae|cj0%1@Fa,]B0d.7">
                                                  <field name="HIGHLIGHT_MODE">javascript</field>
                                                  <field name="TEXT" editor-height="25" editor-width="787.9075">const nombreABuscar = VARS['objeto_detectado'];&amp;#10;&amp;#10;// CORRECCIÓN: Si VARS[nombreABuscar] no existe, usamos una lista vacía []&amp;#10;const objetosAEstudiar = VARS[nombreABuscar] || []; &amp;#10;&amp;#10;const materialesExcepcion = ['-K2_Mat.023', '-K2_Mat.011', '-K4_Mat.023','-K5_Mat.023', '-K6_Mat.024', '-K7_Mat.023'];&amp;#10;const opacidadFondo = 1; &amp;#10;&amp;#10;app.scene.traverse(obj =&gt; {&amp;#10;    if (obj.isMesh &amp;&amp; obj.material) {&amp;#10;        &amp;#10;        // Ahora .includes() no fallará porque objetosAEstudiar siempre será al menos []&amp;#10;        const esProtegido = objetosAEstudiar.includes(obj.name) || &amp;#10;                            (obj.parent &amp;&amp; objetosAEstudiar.includes(obj.parent.name));&amp;#10;&amp;#10;        const mats = Array.isArray(obj.material) ? obj.material : [obj.material];&amp;#10;&amp;#10;        mats.forEach(mat =&gt; {&amp;#10;            mat.transparent = true;&amp;#10;            &amp;#10;            if (materialesExcepcion.includes(mat.name)) {&amp;#10;                mat.opacity = 0.2;&amp;#10;                if (mat.nodeValue) mat.nodeValue.fill(0.2);&amp;#10;            } &amp;#10;            else if (esProtegido) {&amp;#10;                mat.opacity = 1;&amp;#10;                if (mat.nodeValue) mat.nodeValue.fill(1.0);&amp;#10;            } else {&amp;#10;                mat.opacity = opacidadFondo;&amp;#10;                if (mat.nodeValue) mat.nodeValue.fill(opacidadFondo);&amp;#10;            }&amp;#10;            &amp;#10;            mat.needsUpdate = true;&amp;#10;        });&amp;#10;    }&amp;#10;});</field>
