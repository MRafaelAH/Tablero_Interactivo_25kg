                                  <value name="TEXT">
                                    <shadow type="textMultiline" id="GQ)ul!9j[/LA4I^Q8v4d">
                                      <field name="HIGHLIGHT_MODE">javascript</field>
                                      <field name="TEXT" editor-height="37" editor-width="787.9075">const nombreABuscar = VARS['objeto_detectado'];&amp;#10;&amp;#10;// CORRECCIÓN: Si VARS[nombreABuscar] no existe, usamos una lista vacía []&amp;#10;const objetosAEstudiar = VARS[nombreABuscar] || []; &amp;#10;&amp;#10;const materialesExcepcion = ['-K2_Mat.023', '-K2_Mat.011', '-K4_Mat.023','-K5_Mat.023', '-K6_Mat.024', '-K7_Mat.023'];&amp;#10;const opacidadFondo = 0.0; &amp;#10;&amp;#10;&amp;#10;app.scene.traverse(obj =&gt; {&amp;#10;    if (obj.isMesh &amp;&amp; obj.material) {&amp;#10;        &amp;#10;        // Ahora .includes() no fallará porque objetosAEstudiar siempre será al menos []&amp;#10;        const esProtegido = objetosAEstudiar.includes(obj.name) || &amp;#10;                            (obj.parent &amp;&amp; objetosAEstudiar.includes(obj.parent.name));&amp;#10;&amp;#10;        const mats = Array.isArray(obj.material) ? obj.material : [obj.material];&amp;#10;&amp;#10;        mats.forEach(mat =&gt; {&amp;#10;            mat.transparent = true;&amp;#10;            &amp;#10;            if (materialesExcepcion.includes(mat.name)) {&amp;#10;                mat.opacity = 0.2;&amp;#10;                if (mat.nodeValue) mat.nodeValue.fill(0.2);&amp;#10;            } &amp;#10;            else if (esProtegido) {&amp;#10;                mat.opacity = 1;&amp;#10;                if (mat.nodeValue) mat.nodeValue.fill(1.0);&amp;#10;            } else {&amp;#10;                mat.opacity = opacidadFondo;&amp;#10;                if (mat.nodeValue) mat.nodeValue.fill(opacidadFondo);&amp;#10;            }&amp;#10;            &amp;#10;            mat.needsUpdate = true;&amp;#10;        });&amp;#10;    }&amp;#10;});</field>
