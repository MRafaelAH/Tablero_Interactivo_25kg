                          <next>
                            <block type="execScript" id="Mw0r+o2UuFC*ad{AqU2=">
                              <value name="TEXT">
                                <shadow type="textMultiline" id="TQ^i=n*pDmZmy48sJWlB">
                                  <field name="HIGHLIGHT_MODE">javascript</field>
                                  <field name="TEXT" editor-height="37" editor-width="787.9075">// 1. ASEGURAR POSTPROCESADO Y RENDER PASS&amp;#10;if (!app.postprocessing) {&amp;#10;    app.enablePostprocessing();&amp;#10;}&amp;#10;&amp;#10;// 2. DETECCIÓN (TU LÓGICA)&amp;#10;const raycaster = new v3d.Raycaster();&amp;#10;const mouse = new v3d.Vector2();&amp;#10;const rect = app.container.getBoundingClientRect();&amp;#10;&amp;#10;mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;&amp;#10;mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;&amp;#10;&amp;#10;raycaster.setFromCamera(mouse, app.getCamera());&amp;#10;const intersects = raycaster.intersectObjects(app.scene.children, true);&amp;#10;&amp;#10;if (intersects.length &gt; 0) {&amp;#10;    let obj = intersects[0].object;&amp;#10;    if (obj.parent &amp;&amp; (obj.name.includes('Mesh') || obj.name.includes('Object'))) {&amp;#10;        obj = obj.parent;&amp;#10;    }&amp;#10;&amp;#10;    // --- RECONSTRUCCIÓN SEGURA DEL COMPOSER ---&amp;#10;    if (!app.postprocessing.outlinePass) {&amp;#10;        // Bloqueamos el tono para evitar brillos raros&amp;#10;        app.renderer.toneMapping = v3d.NoToneMapping;&amp;#10;&amp;#10;        const composer = app.postprocessing.composer;&amp;#10;        &amp;#10;        // Buscamos el RenderPass original (la imagen del tablero)&amp;#10;        const renderPass = composer.passes.find(p =&gt; p instanceof v3d.RenderPass) &amp;#10;                           || new v3d.RenderPass(app.scene, app.getCamera());&amp;#10;&amp;#10;        // Creamos el OutlinePass&amp;#10;        const oPass = new v3d.OutlinePass(&amp;#10;            new v3d.Vector2(window.innerWidth, window.innerHeight), &amp;#10;            app.scene, &amp;#10;            app.getCamera()&amp;#10;        );&amp;#10;        &amp;#10;        oPass.edgeStrength = 5;&amp;#10;        oPass.edgeThickness = 1.5;&amp;#10;        oPass.visibleEdgeColor.set(0x00ff00); // Verde&amp;#10;        oPass.hiddenEdgeColor.set(0x003300);  // Verde oscuro para lo tapado&amp;#10;        oPass.renderToScreen = true; // &lt;--- ESTO EVITA QUE SE PONGA NEGRO&amp;#10;&amp;#10;        // Reensamblamos: primero la realidad, luego la silueta&amp;#10;        composer.passes = [renderPass, oPass];&amp;#10;        app.postprocessing.outlinePass = oPass;&amp;#10;&amp;#10;        // Sincronización de cámara en tiempo real&amp;#10;        if (!app.renderCallbacks.includes(updateOutlineCamera)) {&amp;#10;            app.renderCallbacks.push(updateOutlineCamera);&amp;#10;        }&amp;#10;    }&amp;#10;&amp;#10;    app.postprocessing.outlinePass.selectedObjects = [obj];&amp;#10;&amp;#10;    // Variables de Puzzles&amp;#10;    VARS['objeto_detectado'] = obj.name;&amp;#10;    VARS['existe_variable'] = (VARS[obj.name] !== undefined) ? 1 : 0;&amp;#10;&amp;#10;} else {&amp;#10;    if (app.postprocessing?.outlinePass) {&amp;#10;        app.postprocessing.outlinePass.selectedObjects = [];&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;// Función de soporte (definirla una sola vez o dejarla fuera)&amp;#10;function updateOutlineCamera() {&amp;#10;    if (app.postprocessing?.outlinePass) {&amp;#10;        app.postprocessing.outlinePass.renderCamera = app.getCamera();&amp;#10;    }&amp;#10;}</field>
                                </shadow>
