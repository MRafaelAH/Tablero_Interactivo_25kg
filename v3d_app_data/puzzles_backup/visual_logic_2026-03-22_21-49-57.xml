                  <field name="HIGHLIGHT_MODE">javascript</field>
                  <field name="TEXT" editor-height="38" editor-width="784.4645244382423">// 1. Configuración de detección (Corrección de clic)&amp;#10;const rect = app.container.getBoundingClientRect();&amp;#10;const mouse = new v3d.Vector2();&amp;#10;&amp;#10;mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;&amp;#10;mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;&amp;#10;&amp;#10;// 2. Raycaster&amp;#10;const raycaster = new v3d.Raycaster();&amp;#10;raycaster.setFromCamera(mouse, app.getCamera());&amp;#10;const intersects = raycaster.intersectObjects(app.scene.children, true);&amp;#10;&amp;#10;let nombreParaPuzzle = "ninguno";&amp;#10;&amp;#10;if (intersects.length &gt; 0) {&amp;#10;    let obj = intersects[0].object;&amp;#10;    &amp;#10;    // Si el nombre es genérico, buscamos al padre&amp;#10;    if (obj.parent &amp;&amp; (obj.name.includes('Mesh') || obj.name.includes('Object'))) {&amp;#10;        nombreParaPuzzle = obj.parent.name;&amp;#10;    } else {&amp;#10;        nombreParaPuzzle = obj.name;&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;// 3. VINCULACIÓN CORRECTA (Para v4.12.0)&amp;#10;// En lugar de v3d.puzzles.vars, usamos el objeto VARS directamente&amp;#10;VARS['objeto_detectado'] = nombreParaPuzzle;&amp;#10;&amp;#10;console.log("Variable 'objeto_detectado' enviada a Puzzles: " + nombreParaPuzzle);</field>
