              <field name="HIGHLIGHT_MODE">javascript</field>
              <field name="TEXT" editor-height="10" editor-width="520">// Usamos la API de materiales directamente para evitar errores de puzzles&amp;#10;const scene = appInstance.scene;&amp;#10;&amp;#10;scene.traverse(function(obj) {&amp;#10;    if (obj.isMesh &amp;&amp; obj.material) {&amp;#10;        // Obtenemos los materiales (manejamos si el objeto tiene varios)&amp;#10;        const materials = Array.isArray(obj.material) ? obj.material : [obj.material];&amp;#10;        &amp;#10;        materials.forEach(function(mat) {&amp;#10;            // Buscamos el nodo de valor en el árbol de nodos del material&amp;#10;            if (mat.nodeRGB &amp;&amp; mat.nodeRGB['Valor_de_Transparencia']) {&amp;#10;                mat.nodeRGB['Valor_de_Transparencia'].value = 0.2;&amp;#10;            } &amp;#10;            // Alternativa para nodos de valor (Value nodes)&amp;#10;            else if (mat.nodeValue &amp;&amp; mat.nodeValue['Valor_de_Transparencia']) {&amp;#10;                mat.nodeValue['Valor_de_Transparencia'].value = 0.2;&amp;#10;            }&amp;#10;        });&amp;#10;    }&amp;#10;});</field>
