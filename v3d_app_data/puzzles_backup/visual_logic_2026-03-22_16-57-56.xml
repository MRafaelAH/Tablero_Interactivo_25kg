              <field name="HIGHLIGHT_MODE">javascript</field>
              <field name="TEXT" editor-height="31" editor-width="784.4645244382423">// 1. DICCIONARIO DE CABLES Y PIEZAS&amp;#10;const grupos = {&amp;#10;    '-Q1': ['Cable 1', 'Cable 2', 'Cable 3', '-Q1'],&amp;#10;    '-KM1': ['Cable 5', 'Cable 6', 'Cable 7', '-KM1'],&amp;#10;    '358288:1': ['Cable 8', 'Cable 9', '358288:1'],&amp;#10;    // Simplemente agrega más líneas aquí siguiendo el mismo formato&amp;#10;};&amp;#10;&amp;#10;// 2. RECUPERAR LO QUE SE TOCÓ DESDE EL PUZZLE&amp;#10;const nombreTocado = v3d.puzzles.procedure_get_param('tocado');&amp;#10;const listaVisible = grupos[nombreTocado] || [nombreTocado];&amp;#10;&amp;#10;// 3. APLICAR TRANSPARENCIA A TODO LO QUE NO ESTÉ EN LA LISTA&amp;#10;app.scene.traverse(obj =&gt; {&amp;#10;    if (obj.isMesh &amp;&amp; obj.material) {&amp;#10;        const mats = Array.isArray(obj.material) ? obj.material : [obj.material];&amp;#10;        const esVisible = listaVisible.includes(obj.name);&amp;#10;&amp;#10;        mats.forEach(mat =&gt; {&amp;#10;            mat.transparent = true;&amp;#10;            mat.opacity = esVisible ? 1.0 : 0.1;&amp;#10;            mat.depthWrite = esVisible; &amp;#10;            &amp;#10;            if (mat.nodeValue) mat.nodeValue.fill(esVisible ? 1.0 : 0.1);&amp;#10;            mat.needsUpdate = true;&amp;#10;        });&amp;#10;    }&amp;#10;});</field>
