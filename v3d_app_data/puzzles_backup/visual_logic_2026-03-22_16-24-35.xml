                  <field name="TEXT" editor-height="10" editor-width="520">var _app = app || appInstance || v3d.apps[0];&amp;#10;&amp;#10;if (_app &amp;&amp; _app.scene) {&amp;#10;    _app.scene.traverse(function(obj) {&amp;#10;        if (obj.isMesh &amp;&amp; obj.material) {&amp;#10;            var materials = Array.isArray(obj.material) ? obj.material : [obj.material];&amp;#10;            &amp;#10;            materials.forEach(function(mat) {&amp;#10;                // Buscamos en las propiedades de nodos del material&amp;#10;                var found = false;&amp;#10;                for (var prop in mat) {&amp;#10;                    if (prop.includes('node') &amp;&amp; mat[prop]) {&amp;#10;                        for (var nodeName in mat[prop]) {&amp;#10;                            // Verificamos si el nombre del nodo es exactamente Control_Alfa&amp;#10;                            if (nodeName === 'Control_Alfa') {&amp;#10;                                mat[prop][nodeName].value = 0.2;&amp;#10;                                console.log('✅ ¡ENCONTRADO! Nodo en: ' + mat.name);&amp;#10;                                found = true;&amp;#10;                            }&amp;#10;                        }&amp;#10;                    }&amp;#10;                }&amp;#10;                &amp;#10;                // Si no se encontró por nombre exacto, intentamos una búsqueda más flexible&amp;#10;                if (!found &amp;&amp; mat.nodeValue) {&amp;#10;                    for (var n in mat.nodeValue) {&amp;#10;                        if (n.toLowerCase().includes('control_alfa')) {&amp;#10;                            mat.nodeValue[n].value = 0.2;&amp;#10;                            console.log('✅ ¡ENCONTRADO (flexible)! en: ' + mat.name);&amp;#10;                        }&amp;#10;                    }&amp;#10;                }&amp;#10;            });&amp;#10;        }&amp;#10;    });&amp;#10;}</field>
